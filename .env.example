# サーバー待機ポート (デフォルト: 3000)
PORT=3000

# 動作環境 (development / production)
NODE_ENV=development

# PoC検証モードフラグ
# true: クイックユーザー切替バーおよび切替APIを有効化 (PoC検証用)
# false: クイック切替をコードレベルで完全無効化 (本番・パイロット運用時)
POC_MODE=true

# セッション暗号化署名キー (本番運用時はランダムな長い文字列に変更してください)
SESSION_SECRET=school-workflow-secret-key-2026-secure-offline-seed
